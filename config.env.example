# 复制到 ~/.grok/config.env 或首次 grok start 交互生成

EMAIL_MODE=tempmail
# EMAIL_MODE=custom
# EMAIL_DOMAIN=example.com
# EMAIL_API=http://127.0.0.1:8080

# 自建 cloudflare_temp_email Worker（无需本地 webhook）
# EMAIL_MODE=cf_temp_email
# CF_TEMP_EMAIL_API=https://mail-api.example.com
# 逗号分隔多个域名做轮换。x.ai 对单个邮箱域的信任度随累计注册量衰减，
# 单域名跑大批量会全部拿到 invalid_grant；某个域连续被拒会自动退出轮换。
# CF_TEMP_EMAIL_DOMAIN=a.example.com,b.example.com,c.example.org
# CF_TEMP_EMAIL_ADMIN=               # 公共建号已开启时可留空
# CF_TEMP_EMAIL_AUTH=                # 可选 x-custom-auth
# CF_TEMP_EMAIL_PREFIX=1

# Outlook / Hotmail plus-address 别名池
# 先执行：grok outlook import ./outlook-accounts.txt
# 文件格式：邮箱----密码----ClientID----RefreshToken
# EMAIL_MODE=outlook
# 每个主邮箱生成的随机 plus-tag 地址数（例如 user+k7m2q9x4ab@outlook.com）
# OUTLOOK_ALIASES_PER_ACCOUNT=5
# 默认是 $GROK_HOME 下的 outlook-accounts.txt / outlook-state.json
# OUTLOOK_ACCOUNTS_FILE=/root/.grok/outlook-accounts.txt
# OUTLOOK_STATE_FILE=/root/.grok/outlook-state.json
# OUTLOOK_POLL_INTERVAL_SEC=5

CLEARANCE_ENABLED=1
REGISTER_PROXY=http://127.0.0.1:40080
# 多代理轮换（逗号/换行）；失败会冷却，自动换下一个。REGISTER_PROXY 也会并入池。
# REGISTER_PROXIES=http://user:pass@isp1:port,http://user:pass@isp2:port
FLARESOLVERR_URL=http://127.0.0.1:8191
CLEARANCE_PROXY=http://privoxy:8118
CLEARANCE_URLS=https://accounts.x.ai,https://x.ai,https://status.x.ai,https://console.x.ai,https://auth.x.ai

# Turnstile：默认本机浏览器 mint（无需外部 farm）
TURNSTILE_PROVIDER=browser
# 可选：外接 YesCaptcha 形 farm
# TURNSTILE_PROVIDER=lite
# LITE_SOLVER_URL=http://127.0.0.1:5072
# CHROME_PATH=                         # 可选；默认自动找 Chrome / ~/.cloakbrowser

# 注册方式：browser=CloakBrowser 页面（默认）
#          browser-mcp=通过 browser-mcp CLI 操作当前真实 Chrome
#          http=旧的 gRPC/Server Action 直连（空 castleRequestToken，易被标 bot）
REGISTER_MODE=browser
# browser-mcp 模式：建议指向 browser-mcp 虚拟环境中的绝对路径。
# 使用无痕窗口，并在注册前/关窗前清除该 store 的 x.ai/Grok Cookie。
BROWSER_MCP_CLI=browser-mcp-cli
BROWSER_MCP_INCOGNITO=1
SIGNUP_BROWSER_TIMEOUT_SEC=180
# 浏览器注册降速：两次尝试最小间隔；命中 email_code_rate_limited 时额外退避
SIGNUP_MIN_INTERVAL_SEC=35
SIGNUP_RATE_LIMIT_BACKOFF_SEC=90
# 浏览器显示策略（注册 + OAuth 同会话）：
#   默认：有 xvfb-run 就用虚拟显示（不抢真实桌面焦点，推荐）
#         没有 xvfb 则纯 headless
#   GROK_SIGNUP_BROWSER_HEADLESS=1  强制纯 headless
#   GROK_SIGNUP_BROWSER_HEADED=1    强制真实窗口（会抢焦点，仅调试）
#   GROK_OAUTH_BROWSER_HEADLESS / GROK_OAUTH_BROWSER_HEADED 同上，控制 OAuth 批准页
# GROK_SIGNUP_BROWSER_HEADLESS=1
# GROK_SIGNUP_BROWSER_HEADED=0

PROTOCOL_HTTP=1
HTTP_POOL_SIZE=8
TEMPMAIL_LOL_RETRIES=30
TEMPMAIL_LOL_MIN_INTERVAL_MS=1500

# OAuth Device Flow：默认串行；invalid_grant/Access denied 首次出现即熔断。
# 如确认只是临时故障，可手动增加 FLOW_RETRIES 或熔断阈值。
OAUTH_WORKERS=1
OAUTH_MIN_INTERVAL_SEC=15
OAUTH_RETRY_SEC=60
OAUTH_FLOW_RETRIES=0
OAUTH_RETRY_DELAY_SEC=30
OAUTH_INVALID_GRANT_LIMIT=1
# x.ai 的批准页面已迁移到 accounts.x.ai Web 前端；默认用真实 CloakBrowser。
# 仅诊断旧接口时才改成 http。
OAUTH_CONFIRM_MODE=browser
OAUTH_BROWSER_TIMEOUT_SEC=150

HTTPS_PROXY=http://127.0.0.1:40080
HTTP_PROXY=http://127.0.0.1:40080
NO_PROXY=127.0.0.1,localhost

PROBE_ENABLED=1
PHYSICAL_CAP=0

# CPA Management 自动上传（宿主机 grok 用 127.0.0.1，不要写 docker 服务名）
# Docker 内网名如 http://cli-proxy-api:8317 仅容器间可解析；宿主机会 DNS 失败。
# 路径需含 /v0/management（上传会再拼 /auth-files）
# CPA_UPLOAD_ENABLED=0
# CPA_MANAGEMENT_BASE=http://127.0.0.1:8317/v0/management
# CPA_MANAGEMENT_KEY=
# CPA_UPLOAD_TIMEOUT_SEC=30
# CPA_UPLOAD_RETRIES=2
# CPA_UPLOAD_NAME_TEMPLATE={email}.json
# CPA_UPLOAD_VERIFY=1
# CPA_UPLOAD_MODE=multipart
